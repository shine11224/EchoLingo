# AI config (any OpenAI-compatible API: DeepSeek, OpenAI, Groq, Ollama, ...)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Optional: faster Whisper transcription via Groq
GROQ_API_KEY=

# Optional: MDX dictionary directory (offline word lookup, see docs/DICTIONARIES.md)
# If empty, falls back to the Eudic dictionary folder (~/AppData/Roaming/Francochinois/eudic/dict)
# DICT_DIR=C:\path\to\your\dicts
DICT_DIR=
