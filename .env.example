# AI config (any OpenAI-compatible Chat Completions API)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Kimi Platform preset: AI_BASE_URL=https://api.moonshot.cn/v1
# Kimi Code preset: AI_BASE_URL=https://api.kimi.com/coding/v1, AI_MODEL=kimi-for-coding
# Kimi Platform and Kimi Code use different API keys; do not mix them.
# Qwen preset: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, AI_MODEL=qwen3.6-flash

# Optional: faster Whisper transcription via Groq
GROQ_API_KEY=

# Optional: MDX dictionary directory (offline word lookup, see docs/DICTIONARIES.md)
# If empty, falls back to the Eudic dictionary folder (~/AppData/Roaming/Francochinois/eudic/dict)
# DICT_DIR=C:\path\to\your\dicts
DICT_DIR=
